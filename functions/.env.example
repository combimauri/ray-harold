# Brevo SMTP login shown in Brevo → SMTP & API → SMTP (looks like 1234abc@smtp-brevo.com).
# The SMTP key itself lives in Secret Manager: npx firebase functions:secrets:set BREVO_SMTP_KEY
BREVO_SMTP_LOGIN=1234abc@smtp-brevo.com
# Sender address verified in Brevo → Senders.
SENDER_EMAIL=invitacion@ejemplo.com
# Comma-separated recipients.
NOTIFY_TO=novios@ejemplo.com
